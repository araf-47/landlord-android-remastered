<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Midnight Obsidian to Deep Warm Umber -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#0D0F14"
                android:centerColor="#1C1917"
                android:endColor="#451A03"
                android:type="linear" />
        </shape>
    </item>

    <!-- Aurora Ribbon Layer: Soft Amber & Coral Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="45"
                android:startColor="#00F59E0B"
                android:centerColor="#26D97706"
                android:endColor="#40B45309"
                android:type="linear" />
        </shape>
    </item>

    <!-- Glassmorphic Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#30FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
