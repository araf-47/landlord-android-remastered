<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Layer: Midnight Obsidian to Deep Indigo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#0A0E17"
                android:centerColor="#16192E"
                android:endColor="#1E1B4B"
                android:type="linear" />
        </shape>
    </item>

    <!-- Aurora Ribbon Layer: Radiant Indigo to Electric Violet Sweep -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="45"
                android:startColor="#004F46E5"
                android:centerColor="#336D28D9"
                android:endColor="#4D4338CA"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ambient Emerald Underglow (Positive Cash Flow Aurora Accent) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#0010B981"
                android:centerColor="#1A10B981"
                android:endColor="#2E059669"
                android:type="linear" />
        </shape>
    </item>

    <!-- Glassmorphic Specular Rim: 1.5dp Frosted Edge Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#35FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
